<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mt_background">

        <!-- 聊天列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/flGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/rvChat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvChat"
        app:layout_constraintVertical_bias="0.283">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivGreeting"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@null"
                android:src="@drawable/mantou" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="今天有什么可以帮您?"
                android:textColor="@color/mt_text_primary"
                android:textSize="20sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/greetingActionChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                app:chipSpacingHorizontal="10dp"
                app:singleLine="true">

                <TextView
                    android:id="@+id/chipStartTask"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingHorizontal="22dp"
                    android:text="开始任务"
                    android:tag="glass:capsule"
                    android:textColor="@color/mt_primary_dark"
                    android:textSize="14sp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/chipLongTermMemory"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingHorizontal="22dp"
                    android:text="长期记忆"
                    android:tag="glass:capsule"
                    android:textColor="@color/mt_primary_dark"
                    android:textSize="14sp"
                    android:includeFontPadding="false" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/generateCodeCard"
        android:layout_width="147dp"
        android:layout_height="75dp"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:contentDescription="打开生成代码编辑器"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/mt_generate_surface"
        app:cardCornerRadius="11dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/mt_generate_surface_soft">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="7dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGenerateCodeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="源码预览"
                    android:textColor="@color/mt_generate_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGenerateCodeLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_generate_language_badge"
                    android:paddingStart="5dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="1dp"
                    android:text="HTML"
                    android:textColor="@color/mt_generate_accent"
                    android:textSize="8sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvGenerateCodePreview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="bottom"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:textColor="@color/mt_generate_code"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/tvGenerateCodeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mt_generate_line"
                android:textSize="8sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inputContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/workspaceSelector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:tag="glass:capsule"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivConversationWorkspace"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder_outline" />

                <TextView
                    android:id="@+id/tvConversationWorkspace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="工作区 · 根目录"
                    android:textColor="@color/mt_text_primary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivConversationWorkspaceChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/inputCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:tag="glass:panel"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/workspaceSelector">

                <HorizontalScrollView
                    android:id="@+id/selectedImageScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/selectedImageStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp" />
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="输入消息"
                    android:imeOptions="flagNoEnterAction"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minHeight="40dp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/mt_text_primary"
                    android:textColorHint="@color/mt_text_muted"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/ivVoiceInput"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="语音输入"
                        android:padding="0dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_composer_voice"
                        app:tint="@color/mt_text_primary" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/ivModelPicker"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_gravity="start|center_vertical"
                            android:background="@drawable/bg_chat_model_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:id="@+id/ivActiveModelIcon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_chat_model_icon"
                                android:importantForAccessibility="no"
                                android:padding="2dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_model_picker" />

                            <TextView
                                android:id="@+id/tvActiveModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="选择模型"
                                android:textColor="@color/mt_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <com.hfad.mantou.view.ContextProgressButton
                        android:id="@+id/ivContextLimit"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="上下文控制"
                        android:padding="0dp" />

                    <ImageButton
                        android:id="@+id/ivAdd"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="选择图片"
                        android:padding="0dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_composer_plus"
                        app:tint="@color/mt_text_primary" />

                    <ImageButton
                        android:id="@+id/ivSend"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_send_circle"
                        android:contentDescription="发送"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="0dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_send_up" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
