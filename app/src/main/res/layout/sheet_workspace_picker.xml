<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="sans-serif-medium"
        android:text="选择工作区目录"
        android:textColor="@color/mt_text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvDirectoryPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/mt_dialog_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDirectoryTree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end|bottom"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddResource"
            style="@style/Widget.ManTou.SheetButton"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="导入资源"
            android:textColor="@color/mt_text_primary"
            app:backgroundTint="@color/mt_dialog_control" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewDirectory"
            style="@style/Widget.ManTou.SheetButton"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="新建文件夹"
            android:textColor="@color/mt_text_primary"
            app:backgroundTint="@color/mt_dialog_control" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseDirectory"
            style="@style/Widget.ManTou.SheetButton"
            android:layout_weight="1"
            android:text="使用此目录"
            android:textColor="@color/mt_on_primary"
            app:backgroundTint="@color/mt_dialog_primary_action" />
    </LinearLayout>
</LinearLayout>
