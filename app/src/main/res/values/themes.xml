<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ManTou" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/mt_primary</item>
        <item name="colorOnPrimary">@color/mt_on_primary</item>
        <item name="colorPrimaryContainer">@color/mt_surface_blue</item>
        <item name="colorOnPrimaryContainer">@color/mt_primary_dark</item>
        <item name="colorSecondary">@color/mt_primary_dark</item>
        <item name="colorOnSecondary">@color/mt_on_primary</item>
        <item name="colorSurface">@color/mt_surface</item>
        <item name="colorOnSurface">@color/mt_text_primary</item>
        <item name="colorSurfaceVariant">@color/mt_surface_soft</item>
        <item name="colorOnSurfaceVariant">@color/mt_text_secondary</item>
        <item name="android:colorBackground">@color/mt_background</item>
        <item name="colorOutline">@color/mt_outline</item>
        <item name="colorError">@color/mt_error</item>
        <item name="android:colorAccent">@color/mt_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/mt_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/mt_background</item>
    </style>

    <style name="Theme.ManTou" parent="Base.Theme.ManTou" />

    <style name="Theme.ManTou.Modal" parent="Base.Theme.ManTou">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowAnimationStyle">@style/MtDialogAnimation</item>
    </style>

    <style name="Theme.ManTou.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ManTou.BottomSheet</item>
    </style>

    <style name="Widget.ManTou.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/mt_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ManTou.Sheet</item>
        <item name="shouldRemoveExpandedCorners">false</item>
        <item name="android:maxWidth">640dp</item>
    </style>

    <style name="ShapeAppearance.ManTou.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.ManTou.SheetButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">13dp</item>
    </style>

    <style name="Theme.ManTou.FullscreenDialog" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowAnimationStyle">@style/MtDialogAnimation</item>
    </style>

    <style name="MtDialogAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/dialog_fade_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>
    </style>
</resources>
